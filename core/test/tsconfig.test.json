{
    "compilerOptions": {
        "sourceMap": true,
        "inlineSources": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "target": "es5",
        "forceConsistentCasingInFileNames": true,
        "importHelpers": false,
        "noEmitHelpers": false,
        "alwaysStrict": true,
        "allowSyntheticDefaultImports": true,
        "removeComments": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "@nevware21/tripwire": [ "../src/index.ts" ]
        }
    },
    "include": [
        "../src/**/*.ts",
        "./src/**/*.ts"
    ],
    "exclude": [
        "node_modules/"
    ]
}