{
    "name": "@nevware21/tripwire",
    "description": "Assertion library and test runner for JavaScript and TypeScript: the same describe/it suites run on node, in a real headless browser and in a web worker from one CLI, with TypeScript compiled on the fly, a compile cache, 14 reporters, coverage and watch mode.",
    "version": "0.1.8",
    "homepage": "https://github.com/nevware21/tripwire",
    "license": "MIT",
    "author": {
        "name": "Nevware21 Solutions LLC",
        "email": "github+tripwire@nevware21.com"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/nevware21"
        },
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/nevware21"
        }
    ],
    "keywords": [
        "test",
        "testing",
        "test-runner",
        "test runner",
        "runner",
        "cli",
        "assertions",
        "assert",
        "expect",
        "chai",
        "mocha",
        "karma",
        "jest",
        "browser",
        "web-worker",
        "worker",
        "puppeteer",
        "typescript",
        "ts",
        "es5",
        "coverage",
        "watch",
        "tdd",
        "bdd",
        "tripwire"
    ],
    "main": "dist/es5/main/tripwire.js",
    "bin": {
        "tripwire": "./bin/tripwire.js"
    },
    "esnext:main": "dist/es6/main/tripwire.js",
    "module": "dist/es5/mod/tripwire.js",
    "esnext:module": "dist/es6/mod/tripwire.js",
    "types": "dist/types/tripwire.d.ts",
    "scripts": {
        "build": "grunt tripwire --verbose && npm run package && npm run dtsgen && npm run globals:dtsgen",
        "rebuild": "npm run build",
        "tripwire": "node ./bin/tripwire.js",
        "package": "rollup -c rollup.config.js --bundleConfigAsCjs",
        "test": "grunt tripwire-test && npm run test:node && npm run test:browser && npm run test:worker && npm run coverage:report",
        "test:node": "nyc --cache node ./bin/tripwire.js --type-check -p ./test/tsconfig.test.json \"./test/src/!(browser|worker)/**/*.test.ts\" -- --trace-uncaught && node ./bin/tripwire.js coverage-report",
        "test:nodesrc": "cross-env TRIPWIRE_PREFER_SOURCE=1 nyc --cache node ./bin/tripwire.js --type-check -p ./test/tsconfig.test.json \"./test/src/!(browser|worker)/**/*.test.ts\" -- --trace-uncaught && node ./bin/tripwire.js coverage-report",
        "test:browser": "node ./bin/tripwire.js --target browser --coverage --type-check -p ./test/tsconfig.test.json \"./test/src/!(node|worker)/**/*.test.ts\"",
        "test:worker": "node ./bin/tripwire.js --target worker --coverage --type-check -p ./test/tsconfig.test.json \"./test/src/!(node|browser)/**/*.test.ts\"",
        "debug:browser": "node ./bin/tripwire.js --target browser --browser-launch open --source-maps --show-files --type-check -p ./test/tsconfig.test.json \"./test/src/!(node|worker)/**/*.test.ts\"",
        "debug:worker": "node ./bin/tripwire.js --target worker --browser-launch open --source-maps --show-files --type-check -p ./test/tsconfig.test.json \"./test/src/!(node|browser)/**/*.test.ts\"",
        "lint": "grunt tripwire-lint",
        "coverage:report": "npm run coverage:nyc && npm run coverage:merge",
        "coverage:nyc": "nyc report --reporter=json",
        "coverage:merge": "merge-coverage",
        "clean": "git clean -xdf && npm install",
        "cleanBuild": "npm run clean && npm run rebuild && npm run docs",
        "docs": "npx typedoc",
        "rush-update": "rush update --recheck --purge --full",
        "dtsgen": "api-extractor run --local --verbose",
        "globals:dtsgen": "node ./scripts/buildGlobalsDts.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nevware21/tripwire.git"
    },
    "bugs": {
        "url": "https://github.com/nevware21/tripwire/issues"
    },
    "licenses": [
        {
            "type": "MIT",
            "url": "https://github.com/nevware21/tripwire/blob/main/LICENSE"
        }
    ],
    "engines": {
        "node": ">= 0.8.0"
    },
    "dependencies": {
        "@nevware21/chromacon": ">= 0.1.4 < 2.x",
        "@nevware21/ts-async": ">= 0.6.1 < 2.x",
        "@nevware21/ts-utils": ">= 0.16.0 < 2.x"
    },
    "peerDependencies": {
        "puppeteer": ">= 20.0.0",
        "puppeteer-core": ">= 20.0.0"
    },
    "peerDependenciesMeta": {
        "puppeteer": {
            "optional": true
        },
        "puppeteer-core": {
            "optional": true
        }
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.34.4",
        "@nevware21/coverage-tools": "^0.1.3",
        "@nevware21/publish-npm": "^0.1.3",
        "@rollup/plugin-commonjs": "^28.0.9",
        "@rollup/plugin-json": "^6.0.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-strip": "^3.0.2",
        "@rollup/plugin-typescript": "^12.2.0",
        "@types/node": "^25.9.5",
        "codecov": "^3.8.3",
        "copyfiles": "^2.4.1",
        "cross-env": "^10.1.0",
        "grunt": "^1.6.3",
        "grunt-cli": "^1.4.3",
        "puppeteer": "^25.1.0",
        "rollup": "^4.54.0",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-istanbul": "^5.0.0",
        "rollup-plugin-minify-es": "^1.1.1",
        "typedoc": "^0.28.2",
        "typedoc-github-theme": "^0.4.0",
        "typescript": "~5.2.2",
        "uglify-js": "^3.15.5"
    }
}
