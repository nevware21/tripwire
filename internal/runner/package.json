{
    "name": "@nevware21/tripwire-runner",
    "description": "Internal runner tooling for tripwire CLI and execution adapters",
    "version": "0.1.8",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "grunt runner-lint --verbose && tsc -p ./tsconfig.json && npm run package && npm run dtsgen && node ../../core/scripts/copyRunnerBin.js",
        "rebuild": "npm run build && npm run test",
        "lint": "grunt runner-lint",
        "package": "rollup -c rollup.config.js --bundleConfigAsCjs",
        "dtsgen": "api-extractor run --local --verbose",
        "test": "npm run test:node && npm run coverage:report",
        "test:node": "nyc --cache node ../../core/bin/tripwire.js --type-check -p ./test/tsconfig.test.json \"./test/src/**/*.test.ts\"",
        "test:nocoverage": "node ../../core/bin/tripwire.js --type-check -p ./test/tsconfig.test.json \"./test/src/**/*.test.ts\"",
        "coverage:report": "nyc report --reporter=json --report-dir=./coverage"
    },
    "dependencies": {
        "@nevware21/tripwire": "0.1.8",
        "@nevware21/ts-utils": ">= 0.16.0 < 2.x",
        "@nevware21/ts-async": ">= 0.6.1 < 2.x",
        "@nevware21/chromacon": ">= 0.1.4 < 2.x",
        "@jridgewell/gen-mapping": "^0.3.13",
        "@jridgewell/trace-mapping": "^0.3.31"
    },
    "peerDependencies": {
        "puppeteer": ">= 20.0.0",
        "puppeteer-core": ">= 20.0.0"
    },
    "peerDependenciesMeta": {
        "puppeteer": {
            "optional": true
        },
        "puppeteer-core": {
            "optional": true
        }
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.34.4",
        "@rollup/plugin-commonjs": "^28.0.9",
        "@rollup/plugin-json": "^6.0.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@types/node": "^25.9.5",
        "rollup": "^4.54.0",
        "rollup-plugin-cleanup": "^3.2.1",
        "uglify-js": "^3.15.5",
        "grunt": "^1.6.3",
        "grunt-cli": "^1.4.3",
        "typescript": "~5.2.2"
    }
}
