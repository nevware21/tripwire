{
    "extends": "@istanbuljs/nyc-config-typescript",
    "branches": 80,
    "lines": 80,
    "functions": 80,
    "statements": 95,
    "all": true,
    "check-coverage": false,
    "reporter": [ "text-summary", "html" ],
    "include": [ "src/**/*.ts" ],
    "exclude": [
        "**/src/index.ts",
        "**/src/interfaces/**",
        "**/src/types/**"
    ],
    "report-dir": "./coverage/nyc"
}
